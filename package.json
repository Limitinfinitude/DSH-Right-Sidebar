{
  "name": "dsh-output-dock",
  "version": "0.2.0",
  "description": "Codex-style output dock for DSH Web: agent-produced md/svg/image/html files are collected, previewed inline, QC-checked, and archived in one panel",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.types.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest",
    "dev": "tsdown --watch"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "dompurify": "^3.2.4",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.6",
    "react": "^18.2.0",
    "tsdown": "^0.16.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
